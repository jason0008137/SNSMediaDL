# SNSMediaDL 設定範例
#
# 用法：複製這個檔案成 config.toml（同一層），改成你要的值。
#   config.toml 已被 gitignore，不會進版控。
#
# 優先序：環境變數 > config.toml > 內建預設。
# 每一項都可以省略，省略就用內建預設值。
#
# ⚠️ Windows 路徑請用「單引號」：TOML 的雙引號字串會把 \ 當跳脫字元，
#    "D:\SNS\media" 裡的 \S 是無效跳脫序列，載入時會直接報錯。
#    要用雙引號的話得寫成 "D:\\SNS\\media"。


# ── 下載位置 ──────────────────────────────────────────────

# 新下載的檔案放哪。目錄結構是 <output_root>/<平台>/<帳號>/<檔名>。
# 沒設定的話是專案底下的 downloads/。
#
# 改這一項**不會搬移既有檔案**：DB 存的是絕對路徑，舊檔留在原處、
# 記錄依然有效，只有之後下載的才會落到新位置。
output_root = 'D:\SNS_Media'

# 額外允許在 GUI 開啟的媒體目錄。
#
# 什麼時候需要：改過 output_root 之後，舊檔案不在新目錄底下，
# GUI 會以「不在允許的媒體目錄內」拒絕提供（那道檢查是用來擋任意檔案讀取的）。
# 把舊目錄列在這裡，舊檔就繼續看得到。
#
# 匯入進來的既有媒體庫也放這裡。
extra_media_roots = [
  'D:\OldMedia\twitter',
]

# 縮圖快取放哪。預設 `<output_root>/thumb`。
#
# GUI 的格線不吐原檔（一頁 60 格、原檔平均 600 KB），改吐 320px 的 WebP，
# 第一次看到某張圖時生成、之後直接讀快取。整個目錄砍掉也不會掉資料，
# 只是下次要重生一次。
#
# 想把它放到 SSD 上（媒體庫在慢碟時差很多）就設這一項。
# thumb_root = 'C:\SNSMediaDL_thumb'

# 檔名格式。可用 token：
#   %date% %post_id% %ordinal% %ext% %platform% %user_screen_name% %kind%
# filename_format = "[%date%] %post_id%_%ordinal%.%ext%"

# 是否依 <平台>/<帳號> 分資料夾。false 會全部平鋪在 output_root 底下。
# group_by_account = true


# ── 伺服器 ────────────────────────────────────────────────

# 本機單機前提：預設只綁 loopback。改成 0.0.0.0 等於把下載歷史對外開放，
# 而且本專案刻意不做認證 —— 改之前請先看 README 的「使用前提」。
# host = "127.0.0.1"
# port = 8765

# db_path = 'D:\SNS_Media\snsmediadl.db'


# ── 下載節流 ──────────────────────────────────────────────
# X 超速會鎖整個帳號約一天，預設值刻意保守。

# 同時幾個下載。⚠ 這是**每個平台各自**的上限，不是全部加起來的總量 ——
# 不同平台打的是不同 host，互相排隊沒有意義。做完一個就立刻補下一個。
# concurrency = 5

# 「任兩次下載開始至少隔幾秒」的**全平台覆寫**。
#
# 留白（預設）= 各平台照自己的來：X 是 1 秒（超速會鎖整個帳號約一天），
# pixiv 是 0（已求證：pixiv 的限速在列舉那一段，不在媒體 CDN）。
#
# 填數字 = 強制覆寫**所有**平台，包含把 X 調快。
# ⚠ 把 X 調到 0 會鎖帳號約一天。那是你的決定，預設不幫你做。
# download_delay_seconds = 1.0

# timeout_seconds = 60.0
# max_attempts = 3

# 啟動時是否自動把佇列裡的媒體抓下來。
# 預設關閉 —— 會自己對外發請求的東西，預設應該是關的。
# GUI 的開關可以即時切換，不必改這裡也不用重啟。
# auto_download = false
# poll_interval_seconds = 5.0


# ── Fediverse / 批次抓取 ──────────────────────────────────

# fetch_delay_seconds = 1.0

# 帳號與帳號之間的間隔（秒）。上面那個只管同一個帳號的翻頁。
# 「一鍵更新」是序列跑的，這個值決定它對同一台伺服器叩門的密度。
# fetch_account_delay_seconds = 2.0
# fetch_page_size = 40
# 上限保護：第一次對大帳號抓會抓到天亮。撞到上限會明講，不會假裝抓完了。
# fetch_max_pages = 20
# fetch_batch_size = 20


# ── 縮圖 ──────────────────────────────────────────────────
#
# 影片縮圖要抽第一個影格，那需要 ffmpeg —— 一支**原生執行檔**，不是 Python
# 套件（PyPI 上叫 `ffmpeg-python` 的那些只是包裝，本身不含執行檔）。
#
# 留空 = 走兩層偵測：
#   1. 系統 PATH 上的（`shutil.which("ffmpeg")`）—— 自己裝的通常較新，優先
#   2. `imageio-ffmpeg` 隨 wheel 帶的那支 —— 它是本專案的相依，所以
#      `pip install -e .` 跑完就有，**一般情況你什麼都不用做**
#
# 設定頁會顯示實際命中的是哪一層。兩層都沒有時：格線上的影片格會說
# 「影片縮圖需要 ffmpeg」，設定頁顯示「未安裝」。
# **圖片與 pixiv 的 ugoira 動圖不受影響**（那兩種不經過 ffmpeg）。
#
# ⚠️ 明確指定了卻找不到，偵測會回報「未安裝」，**不會**偷偷退回其他來源 ——
#    路徑打錯要看得出來。
#
# ⚠️ **不要**把 imageio-ffmpeg 的路徑抄到這裡。那個檔名帶版本號
#    （`ffmpeg-win-x86_64-v7.1.exe`），套件升級的那天這條設定就會失效。
#    留空讓第 2 層在執行時去問，就沒有這個問題。
# ffmpeg_path = "C:/tools/ffmpeg/bin/ffmpeg.exe"

# 同時最多幾個 ffmpeg 行程。一頁 60 格若全是影片，沒有這道閘就是 60 個
# 行程同時起來（縮圖端點跑在 threadpool 上，沒有天然上限）。
# 排隊超過 10 秒的請求會回 503「縮圖排隊逾時」，不會無限期掛著。
# thumb_video_concurrency = 2


# ── 憑證 ──────────────────────────────────────────────────
#
# ⚠️ 這一段是憑證。config.toml 已 gitignore，但仍請確認不要貼進
#    wiki、測試 fixture 或任何會進版控的地方。
#
# 各 Fediverse instance 的 access token（公開內容不需要）：
# instance_tokens = { "baraag.net" = "<token>" }
#
# 各平台的登入憑證。目前只有 pixiv 需要（值是 PHPSESSID）：
# platform_credentials = { pixiv = "<PHPSESSID>" }


# ── 開發用 ────────────────────────────────────────────────

# extension 偵測到檔案變動就自己 reload。正式使用時設 false
# （開著會一直輪詢版本端點）。
# dev_reload = true
